# Caller-side configuration (do not commit real values)
TWITTER_COLLECTOR_URL=https://your-twitter-collector-base-url
TWITTER_COLLECTOR_API_KEY=tc_your_api_key_here

# Required: operator-created group id reserved for this agent
TWITTER_COLLECTOR_AGENT_GROUP_ID=42

# Optional: group IDs that must never be modified
# TWITTER_COLLECTOR_PROTECTED_GROUP_IDS=1,2,3
